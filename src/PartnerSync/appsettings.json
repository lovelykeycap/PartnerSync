{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=partnersync;Username=partnersync;Password=local-password",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "AdminApiKey": "local-admin-key",
  "Sync": {
    "PollIntervalSeconds": 30,
    "RequestTimeoutSeconds": 10,
    "MaxPagesPerSweep": 1000,
    "MaxApplyAttempts": 5,
    "InternalGrpcUrl": "http://localhost:8082",
    "InternalApiKey": "local-internal-key",
    "Partners": [
      {
        "Id": "acme",
        "BaseUrl": "http://localhost:8081/",
        "ApiKey": "local-partner-key",
        "RequestsPerSecond": 5
      }
    ]
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "RepairTopic": "partner-sync.repairs.v1",
    "DeadLetterTopic": "partner-sync.repairs.dlq.v1",
    "GroupId": "partner-sync-apply-v1"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
